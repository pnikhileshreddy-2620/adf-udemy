{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-udemy-learning"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"LS_BLOB_SWITCH_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_BLOB_SWITCH'"
		},
		"LS_GEN2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_GEN2'"
		},
		"LS_LOOKUP_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_LOOKUP'"
		},
		"LS_ONLY_CSV_FILES_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_ONLY_CSV_FILES'"
		},
		"LS_OUTPUT_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_OUTPUT'"
		},
		"LS_PART1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_PART1'"
		},
		"Ls_BlobStorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'Ls_BlobStorage'"
		},
		"LS_GEN2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsgen2udmey.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-udemy-learning_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"LS_BLOB_SWITCH_connectionString": {
						"value": "[parameters('LS_BLOB_SWITCH_connectionString')]"
					},
					"LS_GEN2_accountKey": {
						"value": "[parameters('LS_GEN2_accountKey')]"
					},
					"LS_LOOKUP_connectionString": {
						"value": "[parameters('LS_LOOKUP_connectionString')]"
					},
					"LS_ONLY_CSV_FILES_connectionString": {
						"value": "[parameters('LS_ONLY_CSV_FILES_connectionString')]"
					},
					"LS_OUTPUT_connectionString": {
						"value": "[parameters('LS_OUTPUT_connectionString')]"
					},
					"LS_PART1_connectionString": {
						"value": "[parameters('LS_PART1_connectionString')]"
					},
					"Ls_BlobStorage_connectionString": {
						"value": "[parameters('Ls_BlobStorage_connectionString')]"
					},
					"LS_GEN2_properties_typeProperties_url": {
						"value": "[parameters('LS_GEN2_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-udemy-learning_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-udemy-learning_ArmTemplate_0')]"
			]
		},
		{
			"name": "adf-udemy-learning_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-udemy-learning_ArmTemplate_1')]"
			]
		}
	]
}